@prefix cloud: <https://example.com/cloud#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A test vocabulary in the shape a source plugin declares one: a reference type
# under ref:ExternalReference and a rule that types an untyped reference node.

<https://example.com/cloud> a owl:Ontology ;
    rdfs:label "Test cloud vocabulary" .

cloud:Reference a owl:Class ;
    rdfs:subClassOf ref:ExternalReference .

cloud:object-id a owl:DatatypeProperty ;
    rdfs:range xsd:string .

cloud:ReferenceShape a sh:NodeShape ;
    sh:targetObjectsOf ref:hasExternalReference ;
    sh:rule [
        a sh:TripleRule ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [ sh:path cloud:object-id ; sh:minCount 1 ]
        ] ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object cloud:Reference
    ] .
