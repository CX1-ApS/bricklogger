@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix bacnet: <http://data.ashrae.org/bacnet/> .
@prefix bacnet2020: <http://data.ashrae.org/bacnet/2020#> .
@prefix bl: <urn:bricklogger:shapes#> .

# Bricklogger's supplementary SHACL rules, run together with Brick's own at
# activation. Brick's reference schema types a BACnet reference only when it is
# written in the vocabulary the bundled Brick knows; models in the wild use
# two: the 2020 namespace with objectOf, and the plain namespace with contains.
# A reference node that carries an object identifier in either is a BACnet
# reference, whichever way it links to its device.

bl:BACnetReferenceByIdentifier a sh:NodeShape ;
    rdfs:label "BACnet reference by object identifier" ;
    sh:targetObjectsOf ref:hasExternalReference ;
    sh:rule [
        a sh:TripleRule ;
        sh:condition [
            a sh:NodeShape ;
            sh:or (
                [ sh:property [ sh:path bacnet:object-identifier ; sh:minCount 1 ] ]
                [ sh:property [ sh:path bacnet2020:object-identifier ; sh:minCount 1 ] ]
            )
        ] ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object ref:BACnetReference
    ] .
